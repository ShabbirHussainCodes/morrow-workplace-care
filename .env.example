# Copy this file to .env for local development. Never commit the real .env file.

# Neon Postgres connection string (Vercel adds this automatically when you connect Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string, used to hash IP addresses for rate limiting (raw IPs are never stored)
IP_SALT=change-me-to-a-long-random-string
