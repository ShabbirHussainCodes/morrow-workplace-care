# Copy this file to .env for local development. Never commit the real .env file.
# Every value below is a placeholder. The functions refuse to start with a placeholder or a
# weak value (they answer 500 and log the variable NAME, never the value).
#
# Generate a random value locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never paste a real secret into chat, a pull request or an issue.

# Neon Postgres connection string. Locally and on Preview deployments use the Neon DEV branch.
# Only the Production environment in Vercel points at the production branch.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string (at least 16 characters) used to hash IP addresses for rate limiting.
# Raw IP addresses are never stored.
IP_SALT=replace-with-a-random-value

# Random string (at least 32 characters) that signs the admin session cookie.
# Changing it signs every admin out.
SESSION_SECRET=replace-with-a-random-value

# Random string (at least 32 characters). Vercel sends it as "Authorization: Bearer <value>"
# when it runs the daily retention job, and the job refuses any other caller.
CRON_SECRET=replace-with-a-random-value

# scrypt hash of the admin password, created by running: npm run hash-password
# The password itself is never stored anywhere.
ADMIN_PASSWORD_HASH=replace-with-the-output-of-npm-run-hash-password
